override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Private keys and certificates
*.pem
*.key
id_rsa
id_ed25519

# Environment files
.env
.env.*

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db


